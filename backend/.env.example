DATABASE_URL=sqlite:///./clinic.db
# Optional. Answers stay extractive from labels/chunks.jsonl when this is unset.
GOOGLE_API_KEY=
# Public wss URL ngrok gives Twilio for inbound calls only.
PUBLIC_VOICE_WSS_URL=wss://localhost:8000/voice/ws
# Base URL used in patient consent email links (Approve / Decline).
PUBLIC_API_BASE_URL=http://localhost:8000
# Referral consent link lifetime in hours (default 7 days).
REFERRAL_CONSENT_TTL_HOURS=168
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_SENDING_ENABLED=false
EMAIL_REDIRECT_TO=
# Talk room link included in referral consent + yes/no decision emails.
REFERRAL_TALK_URL=https://8935-2001-468-300-800-7479-bf77-f309-d1f6.ngrok-free.app/talk/-_Xf8sGnvTC7KLZ298C-lrxhlMNV83J3
# Optional Expo push token(s) for expo.dev/notifications / backend demo pushes.
# Comma-separated ExponentPushToken[...] values. Prefer registering from the app.
EXPO_PUSH_TOKEN=
