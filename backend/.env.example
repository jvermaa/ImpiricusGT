DATABASE_URL=sqlite:///./clinic.db
# Optional. Answers stay extractive from labels/chunks.jsonl when this is unset.
GOOGLE_API_KEY=
# Public wss URL ngrok gives Twilio for inbound calls only.
PUBLIC_VOICE_WSS_URL=wss://localhost:8000/voice/ws

# Gemini drafts. Leave blank to use the built-in email and referral templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SMTP. Never commit real passwords. Use a Gmail App Password or a Mailtrap sandbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# false simulates a send and does not contact the SMTP server.
EMAIL_SENDING_ENABLED=false
# When set, every message goes here instead of the patient's address.
EMAIL_REDIRECT_TO=
